---
// Portraits d'art de la faune du Kruger, au format 3:4, dans le langage
// graphique du site (crépuscule, silhouettes). Chaque vignette est prévue
// pour être remplacée par une photographie réelle du même cadrage.
// `type` : 'lion' | 'elephant' | 'hippo'
const { type } = Astro.props;
---

{
  type === 'lion' && (
    <svg viewBox="0 0 540 720" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Silhouette d’un lion au crépuscule">
      <defs>
        <linearGradient id="gLion" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#2c1a0e" />
          <stop offset="0.55" stop-color="#8a4a26" />
          <stop offset="1" stop-color="#d9832e" />
        </linearGradient>
      </defs>
      <rect width="540" height="720" fill="url(#gLion)" />
      <circle cx="270" cy="430" r="185" fill="#ffd98a" opacity="0.18" />
      <circle cx="270" cy="430" r="132" fill="#ffd98a" opacity="0.9" />
      <g stroke="#241a11" stroke-width="3.5" fill="none" stroke-linecap="round" opacity="0.85">
        <path d="M120 180 q9 -11 18 0 q9 -11 18 0" />
        <path d="M330 130 q7 -9 14 0 q7 -9 14 0" />
      </g>
      <path d="M0 585 C120 572 300 578 540 570 L540 720 0 720 Z" fill="#1c1209" />
      <g fill="#1c1209">
        <circle cx="210" cy="420" r="78" />
        <circle cx="188" cy="468" r="70" />
        <circle cx="238" cy="472" r="64" />
        <circle cx="160" cy="398" r="40" />
        <path d="M124 384 C100 388 88 402 88 420 C88 436 102 446 124 446 L136 442 L132 386 Z" />
        <path d="M96 440 C100 456 114 464 132 462 L136 444 Z" />
        <path d="M176 348 l14 -26 l18 22 Z" />
        <ellipse cx="320" cy="478" rx="118" ry="62" />
        <rect x="238" y="505" width="25" height="82" rx="10" />
        <rect x="284" y="520" width="25" height="67" rx="10" />
        <rect x="352" y="520" width="25" height="67" rx="10" />
        <rect x="398" y="505" width="25" height="82" rx="10" />
        <path d="M428 452 C452 434 464 410 462 382 L474 384 C478 414 464 442 438 464 Z" />
        <circle cx="472" cy="380" r="15" />
      </g>
      <g stroke="#1c1209" stroke-width="4" fill="none" stroke-linecap="round">
        <path d="M80 585 C80 568 74 556 66 548" />
        <path d="M94 585 C94 566 100 554 108 548" />
        <path d="M470 578 C470 562 464 550 456 544" />
      </g>
    </svg>
  )
}

{
  type === 'elephant' && (
    <svg viewBox="0 0 540 720" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Silhouette d’un éléphant au crépuscule">
      <defs>
        <linearGradient id="gElephant" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#2c1a0e" />
          <stop offset="0.55" stop-color="#a3431f" />
          <stop offset="1" stop-color="#e08a3c" />
        </linearGradient>
      </defs>
      <rect width="540" height="720" fill="url(#gElephant)" />
      <circle cx="270" cy="410" r="195" fill="#ffd98a" opacity="0.16" />
      <circle cx="270" cy="410" r="138" fill="#ffd98a" opacity="0.88" />
      <g stroke="#241a11" stroke-width="3.5" fill="none" stroke-linecap="round" opacity="0.85">
        <path d="M370 150 q9 -11 18 0 q9 -11 18 0" />
        <path d="M120 210 q7 -9 14 0 q7 -9 14 0" />
      </g>
      <path d="M0 585 C160 574 360 580 540 572 L540 720 0 720 Z" fill="#1c1209" />
      <g fill="#1c1209">
        <path d="M180 420 C180 380 260 355 330 360 C410 366 455 410 458 460 C460 500 452 530 440 550 L200 550 C186 515 180 470 180 420 Z" />
        <rect x="212" y="500" width="38" height="92" rx="13" />
        <rect x="278" y="515" width="38" height="77" rx="13" />
        <rect x="352" y="515" width="38" height="77" rx="13" />
        <rect x="408" y="500" width="38" height="92" rx="13" />
        <circle cx="172" cy="408" r="62" />
        <path d="M200 350 C230 336 262 340 280 358 C256 358 232 368 220 388 Z" />
        <path d="M140 366 C104 394 96 448 112 486 C120 466 138 452 160 450 C142 430 140 398 152 372 Z" />
        <path d="M138 380 C104 400 84 444 88 494 C92 538 84 566 68 584 L94 592 C112 568 118 534 114 494 C112 452 126 414 154 394 Z" />
        <path d="M446 460 C462 474 466 492 462 510 L452 506 C454 492 450 478 440 468 Z" />
      </g>
      <path d="M152 462 C136 478 126 500 124 524 L136 526 C140 504 150 488 164 476 Z" fill="#f3d9a4" opacity="0.9" />
      <g stroke="#1c1209" stroke-width="4" fill="none" stroke-linecap="round">
        <path d="M80 582 C80 566 74 554 66 548" />
        <path d="M470 578 C470 562 476 550 484 544" />
      </g>
    </svg>
  )
}

{
  type === 'hippo' && (
    <svg viewBox="0 0 540 720" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Silhouette d’un hippopotame dans un point d’eau au crépuscule">
      <defs>
        <linearGradient id="gHippoCiel" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#2c1a0e" />
          <stop offset="0.7" stop-color="#6b3317" />
          <stop offset="1" stop-color="#d9832e" />
        </linearGradient>
        <linearGradient id="gHippoEau" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#2e5e6e" />
          <stop offset="1" stop-color="#16303c" />
        </linearGradient>
      </defs>
      <rect width="540" height="500" fill="url(#gHippoCiel)" />
      <circle cx="270" cy="400" r="180" fill="#ffd98a" opacity="0.18" />
      <circle cx="270" cy="400" r="126" fill="#ffd98a" opacity="0.9" />
      <g stroke="#241a11" stroke-width="3.5" fill="none" stroke-linecap="round" opacity="0.85">
        <path d="M140 170 q9 -11 18 0 q9 -11 18 0" />
        <path d="M360 220 q7 -9 14 0 q7 -9 14 0" />
      </g>
      <g fill="#1c1209">
        <path d="M96 512 C100 452 150 420 250 420 C340 420 396 448 408 496 L410 520 96 520 Z" />
        <path d="M350 470 C350 448 372 436 406 436 C446 436 476 452 480 480 C482 496 478 510 470 520 L354 520 Z" />
        <circle cx="392" cy="436" r="13" />
        <circle cx="452" cy="446" r="10" />
      </g>
      <rect y="500" width="540" height="220" fill="url(#gHippoEau)" />
      <rect y="500" width="540" height="10" fill="#f3d9a4" opacity="0.25" />
      <path d="M180 560 q30 -12 60 0 q30 -12 60 0" stroke="#cfe3e2" stroke-width="4" fill="none" stroke-linecap="round" opacity="0.35" />
      <path d="M320 620 q26 -10 52 0 q26 -10 52 0" stroke="#cfe3e2" stroke-width="4" fill="none" stroke-linecap="round" opacity="0.28" />
      <path d="M90 650 q26 -10 52 0" stroke="#cfe3e2" stroke-width="4" fill="none" stroke-linecap="round" opacity="0.22" />
      <ellipse cx="290" cy="540" rx="150" ry="14" fill="#0e2129" opacity="0.55" />
    </svg>
  )
}
